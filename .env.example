# ---------------------------------------------------------------- web app
# Host port the site is published on (docker-compose)
HOST_PORT=3000
# Container time zone (used only for server log timestamps; the UI shows each viewer's local time)
TZ=Australia/Sydney

# First admin account – created only when the database has no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Set to true when served over HTTPS (behind a reverse proxy) so the session cookie is Secure-only.
COOKIE_SECURE=false
SESSION_DAYS=7
# How often the scheduler checks for a changeover (seconds, min 10)
CHECK_INTERVAL_SECONDS=30

# ------------------------------------------------------------ Yeastar API
# PBX web address incl. port, e.g. https://yourcompany.ras.yeastar.com or https://192.168.1.10:8088
YEASTAR_BASE_URL=https://pbx.example.com
# Open API credentials: PBX → Integrations → API → enable, then copy Client ID / Client Secret.
# Also add this server's IP to the API allowed IP list.
YEASTAR_CLIENT_ID=
YEASTAR_CLIENT_SECRET=
# Optional: initial inbound route ID (can be picked in the web UI instead, under PBX)
YEASTAR_INBOUND_ROUTE_ID=
# Accept self-signed PBX certificates
YEASTAR_INSECURE_TLS=false
# true = log the changes instead of sending them to the PBX (safe testing)
YEASTAR_DRY_RUN=true

# ------------------------------------------- inbound route field mapping
# Defaults match the P-Series Open API. Check a GET of your route
# (inbound_route/get) if your firmware uses different names/values.
YEASTAR_API_PATH=/openapi/v1.0
YEASTAR_DEST_FIELD=def_dest
YEASTAR_DEST_VALUE_FIELD=def_dest_value
YEASTAR_EXTERNAL_DEST_TYPE=external_num
# Prefix prepended to the mobile number (e.g. an outbound route dial prefix)
YEASTAR_NUMBER_PREFIX=
# Extra JSON fields sent with every "forward to mobile" update, e.g. {"def_dest_prefix":"9"}
YEASTAR_EXTRA_FIELDS_JSON=
